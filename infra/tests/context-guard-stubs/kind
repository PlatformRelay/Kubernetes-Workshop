#!/usr/bin/env bash
set -eu

echo "kind $*" >> "${MOCK_LOG:?stub requires MOCK_LOG}"
[ "${MOCK_KIND_EXIT:-0}" = 0 ] || exit "$MOCK_KIND_EXIT"

case "$*" in
  "get clusters") printf '%s\n' "${MOCK_KIND_CLUSTERS-}" ;;
  "get nodes --name "*) printf '%s\n' "${MOCK_KIND_NODES-}" ;;
  "get kubeconfig --name "*)
    printf '%s\n' \
      'apiVersion: v1' \
      'clusters:' \
      '- cluster:' \
      "    server: ${MOCK_KIND_SERVER-}"
    ;;
esac
