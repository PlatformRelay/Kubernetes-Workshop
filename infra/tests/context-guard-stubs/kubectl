#!/usr/bin/env bash
set -eu

echo "kubectl $*" >> "${MOCK_LOG:?stub requires MOCK_LOG}"

case "$*" in
  "config current-context")
    [ "${MOCK_CURRENT_CONTEXT_EXIT:-0}" = 0 ] || exit "$MOCK_CURRENT_CONTEXT_EXIT"
    printf '%s\n' "${MOCK_KUBECTL_CONTEXT-}"
    ;;
  "config view --minify -o jsonpath={.contexts[0].context.cluster}")
    [ "${MOCK_CONFIG_VIEW_EXIT:-0}" = 0 ] || exit "$MOCK_CONFIG_VIEW_EXIT"
    printf '%s' "${MOCK_KUBECTL_CLUSTER-}"
    ;;
  "config view --minify -o jsonpath={.clusters[0].cluster.server}")
    [ "${MOCK_CONFIG_VIEW_EXIT:-0}" = 0 ] || exit "$MOCK_CONFIG_VIEW_EXIT"
    printf '%s' "${MOCK_KUBECTL_SERVER-}"
    ;;
  "config view --minify -o jsonpath={.contexts[0].context.namespace}")
    [ "${MOCK_CONFIG_VIEW_EXIT:-0}" = 0 ] || exit "$MOCK_CONFIG_VIEW_EXIT"
    printf '%s' "${MOCK_KUBECTL_NAMESPACE-}"
    ;;
  "get node "*" -o jsonpath={.metadata.labels.kubernetes\\.io/hostname}|{.spec.providerID}")
    [ "${MOCK_NODE_EXIT:-0}" = 0 ] || exit "$MOCK_NODE_EXIT"
    printf '%s' "${MOCK_NODE_IDENTITY-}"
    ;;
  "--namespace kube-system get configmap platformrelay-workshop-ownership -o jsonpath={.data.cluster}")
    if [ "${MOCK_OWNERSHIP_EXIT:-0}" != 0 ]; then
      case "${MOCK_OWNERSHIP_ERROR_KIND:-notfound}" in
        notfound) printf '%s\n' "${MOCK_OWNERSHIP_ERROR-}" >&2 ;;
        forbidden) printf '%s\n' 'Error from server (Forbidden): configmaps is forbidden' >&2 ;;
        timeout) printf '%s\n' 'Unable to connect to the server: context deadline exceeded' >&2 ;;
        tls) printf '%s\n' 'Unable to connect to the server: x509: certificate signed by unknown authority' >&2 ;;
      esac
      exit "$MOCK_OWNERSHIP_EXIT"
    fi
    printf '%s' "${MOCK_OWNERSHIP_CLUSTER-}"
    ;;
  "create configmap platformrelay-workshop-ownership --namespace kube-system --from-literal=cluster="*)
    printf 'configmap/platformrelay-workshop-ownership created\n'
    ;;
  *)
    ;;
esac
