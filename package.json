{
  "name": "kubernetes-practitioner-workshop",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "deck": "node scripts/deck.mjs",
    "decks:generate": "node scripts/generate-decks.mjs",
    "decks:check": "node scripts/generate-decks.mjs --check",
    "dev": "node scripts/deck.mjs",
    "dev:day1": "slidev slides-day-1.md --open",
    "dev:day2": "slidev slides-day-2.md --open",
    "dev:day3": "slidev slides-day-3.md --open",
    "dev:optional": "slidev slides-optional.md --open",
    "dev:superset": "slidev slides.md --open",
    "dev:3day": "slidev slides-3day.md --open",
    "dev:templates": "slidev slides-templates.md --open",
    "build": "pnpm decks:check && pnpm build:day1 && pnpm build:day2 && pnpm build:day3 && pnpm build:optional",
    "build:day1": "slidev build slides-day-1.md --base /day-1/ --out dist-day-1",
    "build:day2": "slidev build slides-day-2.md --base /day-2/ --out dist-day-2",
    "build:day3": "slidev build slides-day-3.md --base /day-3/ --out dist-day-3",
    "build:optional": "slidev build slides-optional.md --base /optional/ --out dist-optional",
    "build:superset": "slidev build slides.md",
    "build:3day": "slidev build slides-3day.md --base /3day/ --out dist-3day",
    "build:templates": "slidev build slides-templates.md --base /templates/ --out dist-templates",
    "export": "pnpm decks:check && pnpm export:day1 && pnpm export:day2 && pnpm export:day3 && pnpm export:optional",
    "export:day1": "slidev export slides-day-1.md --output slides-day-1-export",
    "export:day2": "slidev export slides-day-2.md --output slides-day-2-export",
    "export:day3": "slidev export slides-day-3.md --output slides-day-3-export",
    "export:optional": "slidev export slides-optional.md --output slides-optional-export",
    "export:superset": "slidev export slides.md",
    "export:3day": "slidev export slides-3day.md --output slides-3day-export",
    "export:templates": "slidev export slides-templates.md --output slides-templates-export",
    "render": "slidev export slides.md --format png --per-slide --output dist-render",
    "render:clicks": "slidev export slides.md --format png --per-slide --with-clicks --output dist-render",
    "render:3day": "slidev export slides-3day.md --format png --per-slide --output dist-render-3day",
    "showcase:gif": "node scripts/make-showcase-gif.mjs",
    "test:deck": "node --test scripts/deck.test.mjs",
    "test:provenance": "node --test scripts/workshop-provenance.test.mjs",
    "lint": "markdownlint-cli2",
    "lint:fix": "markdownlint-cli2 --fix",
    "link-check": "node scripts/link-check.mjs"
  },
  "dependencies": {
    "@slidev/cli": "^52.16.0",
    "@slidev/theme-default": "latest",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.2",
    "playwright-chromium": "^1.61.1",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0"
  }
}
